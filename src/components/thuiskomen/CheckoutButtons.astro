---
import Button from "../Button.astro";
import { CHECKOUT_URL_INEENS, CHECKOUT_URL_TERMIJNEN, WACHTLIJST_URL } from "../../lib/thuiskomen";

// De twee betaalknoppen. Eén component voor alle plaatsingen op beide sales pages,
// zodat links, teksten en tracking overal identiek zijn. Na de deadline (html.signup-closed)
// vervangt één wachtlijstknop de betaalknoppen.
---

<div class="signup-open-only flex flex-col sm:flex-row gap-4 justify-center">
	<a
		href={CHECKOUT_URL_INEENS}
		data-checkout
		data-payment-option="single"
		data-cta-text="Ik doe mee, €997 ineens"
		class="inline-flex justify-center items-center text-center font-heading font-medium rounded-full px-8 py-4 md:px-10 md:py-5 text-base md:text-lg transition-all duration-300 ease-in-out hover:-translate-y-1 bg-[var(--color-brand-accent)] hover:bg-[var(--color-brand-accent-hover)] text-white shadow-lg shadow-[var(--color-brand-accent)]/25 hover:shadow-xl hover:shadow-[var(--color-brand-accent)]/30"
	>
		Ik doe mee, € 997 ineens
	</a>
	<a
		href={CHECKOUT_URL_TERMIJNEN}
		data-checkout
		data-payment-option="installments"
		data-cta-text="Ik doe mee, in 3 termijnen"
		class="inline-flex justify-center items-center text-center font-heading font-medium rounded-full px-8 py-4 md:px-10 md:py-5 text-base md:text-lg transition-all duration-300 ease-in-out hover:-translate-y-1 bg-[var(--color-brand-secondary)] hover:bg-[#D5C2B9] text-[var(--color-brand-primary-text)] shadow-sm hover:shadow-md"
	>
		Ik doe mee, in 3 termijnen
	</a>
</div>
<div class="signup-closed-only flex justify-center">
	<Button href={WACHTLIJST_URL} className="text-base md:text-lg px-8 py-4 md:px-10 md:py-5">
		Zet mij op de wachtlijst
	</Button>
</div>

<script>
	// Plug&Pay-checkout: GA4 client_id + de UTM's van deze bezoek meegeven. De purchase wordt
	// server-side verstuurd (Plug&Pay-webhook → n8n → GA4 Measurement Protocol); met dit client_id
	// hangt die aankoop aan de juiste bezoeker en bron. Plug&Pay slaat utm_* op bij de order.
	function withCheckoutParams(href: string): string {
		const url = new URL(href, window.location.href);
		if (url.hostname !== "shop.crystalhelder.nl") return href;
		const page = new URLSearchParams(window.location.search);
		["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"].forEach((key) => {
			const value = page.get(key);
			if (value && !url.searchParams.has(key)) url.searchParams.set(key, value);
		});
		// _ga-cookie: GA1.1.<random>.<timestamp> → client_id "<random>.<timestamp>"
		const ga = document.cookie.match(/(?:^|;\s*)_ga=GA\d\.\d\.(\d+\.\d+)/);
		if (ga) url.searchParams.set("ga_client_id", ga[1]);
		return url.toString();
	}

	// DataLayer: begin_checkout tracking on the two checkout buttons.
	// Cross-origin redirect must wait for the dataLayer event to be sent — see tracking-patterns.md.
	document.addEventListener("DOMContentLoaded", () => {
		document.querySelectorAll("[data-checkout]").forEach((el) => {
			el.addEventListener("click", (e) => {
				e.preventDefault();
				const href = withCheckoutParams(el.getAttribute("href") as string);
				const paymentOption = el.getAttribute("data-payment-option");
				const ctaText = el.getAttribute("data-cta-text");

				let navigated = false;
				function navigate() {
					if (navigated) return;
					navigated = true;
					window.location.href = href as string;
				}

				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push({
					event: "begin_checkout",
					cta_text: ctaText,
					payment_option: paymentOption,
					value: 997,
					currency: "EUR",
					eventCallback: navigate,
					eventTimeout: 2000,
				});
				setTimeout(navigate, 2500);
			});
		});
	});
</script>
