---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import { Picture } from "astro:assets";
import bgIllustration from "../../assets/images/bedankt_hero.png";

// Boekingslink inzichtgesprek (Cal.com "inzicht"), zelfde als in het formulier.
const BOOKING_URL =
	"https://cal.com/crystalhelder/inzicht?utm_source=evaluatie&utm_medium=bedankt&utm_campaign=jpie_ronde2";

// Gumlet: "Podcast 1" (try-out podcast). player_color: terracotta i.p.v. Gumlet-paars
// (waarde moet URL-encoded, %23 = #).
const GUMLET_VIDEO_ID = "6aaf03997d44d89d015cbff4";
const VIDEO_SRC = `https://play.gumlet.io/embed/${GUMLET_VIDEO_ID}?player_color=%23BC5940`;
---

<Layout
	title="Dank je wel — Je pijn is echt | Crystal Helder"
	description="Dank je wel voor je antwoorden."
	robots="noindex, nofollow"
	includeCal={false}
	showConsentBanner={false}
>
	<main class="relative min-h-[100svh] px-4 sm:px-6 py-10 sm:py-16 flex justify-center items-start md:items-center">
		<div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
			<div class="absolute -top-[10%] -right-[26%] w-[340px] md:-top-[16%] md:-right-[14%] md:w-[520px] rotate-[12deg] opacity-70 ev-wash">
				<Picture src={bgIllustration} alt="" widths={[340, 520]} sizes="520px" class="w-full h-auto" />
			</div>
			<div class="absolute -bottom-[6%] -left-[30%] w-[320px] md:-left-[14%] md:w-[480px] rotate-[192deg] opacity-60 ev-wash">
				<Picture src={bgIllustration} alt="" widths={[320, 480]} sizes="480px" class="w-full h-auto" />
			</div>
		</div>

		<div class="relative w-full max-w-[640px] bg-white rounded-[2rem] md:rounded-[2.5rem] shadow-2xl shadow-[var(--color-brand-accent)]/15 px-6 py-10 sm:px-10 sm:py-12">
			<div class="text-center">
				<h1 class="font-heading font-semibold text-[2rem] sm:text-[2.5rem] leading-[1.15] tracking-tight text-balance text-[var(--color-brand-primary-text)] mb-5">
					Dank je wel voor je antwoorden
				</h1>
				<p class="text-lg sm:text-xl leading-[1.7] text-[var(--color-brand-primary-text)]/85">
					Zoals beloofd heb ik iets voor je. Dit is de try-out van een podcast waar ik aan werk. Je bent een van de eersten die hem ziet.
				</p>
			</div>

			<div class="mt-10 pt-9 border-t border-[var(--color-brand-secondary)]">
				<h2 class="font-heading font-semibold text-2xl sm:text-[1.75rem] leading-tight text-balance text-[var(--color-brand-primary-text)] mb-4">
					Wat als je klacht een signaal is?
				</h2>
				<p class="text-lg leading-[1.7] text-[var(--color-brand-primary-text)]/85 mb-7">
					In 10 minuten neem ik je mee in een andere manier van kijken naar je lichaam: als iets wat reageert en je informatie geeft. Met een persoonlijk verhaal over mijn dochter, dat mijn blik op klachten voorgoed veranderde.
				</p>
				<div class="relative w-full rounded-2xl overflow-hidden bg-[#3A302D] shadow-[0_24px_60px_-20px_rgba(188,89,64,0.45)]" style="aspect-ratio: 16 / 9;">
					<iframe
						src={VIDEO_SRC}
						title="Wat als je klacht een signaal is? Try-out podcast"
						class="absolute inset-0 w-full h-full border-0"
						allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen"
						allowfullscreen
					></iframe>
				</div>
			</div>

			{/* Alleen als in het formulier "Nog niet" is gekozen bij "Heb je al een inzichtgesprek geboekt?" */}
			<div id="boeking" class="ev-cond mt-10 pt-9 border-t border-[var(--color-brand-secondary)] text-center" hidden>
				<h2 class="font-heading font-semibold text-2xl sm:text-[1.75rem] leading-tight text-balance text-[var(--color-brand-primary-text)] mb-4">
					Wil je ontdekken waar jouw lichaam op reageert?
				</h2>
				<p class="text-lg leading-[1.7] text-[var(--color-brand-primary-text)]/85 mb-7">
					In een inzichtgesprek van 45 minuten kijken we samen naar jouw klachten. Je kunt je gesprek boeken tot en met 25 september.
				</p>
				<Button
					href={BOOKING_URL}
					target="_blank"
					rel="noopener"
					data-track-booking="bedankt"
					className="w-full sm:w-auto text-lg px-10 py-5"
				>
					Boek je inzichtgesprek
				</Button>
			</div>

			{/* Alleen als in het formulier "Ja" is gekozen */}
			<div id="gepland" class="ev-cond mt-10 pt-9 border-t border-[var(--color-brand-secondary)] text-center" hidden>
				<p class="font-heading font-medium text-xl sm:text-2xl leading-snug text-balance text-[var(--color-brand-primary-text)]">
					Je inzichtgesprek staat gepland. Ik kijk ernaar uit.
				</p>
			</div>
		</div>
	</main>
</Layout>

<style is:global>
	.ev-wash {
		mix-blend-mode: multiply;
		-webkit-mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
		mask-image: radial-gradient(closest-side, #000 55%, transparent 100%);
	}
	.ev-cond[hidden] { display: none; }
</style>

<script>
	(function () {
		// Het antwoord op "Heb je al een inzichtgesprek geboekt?" staat in sessionStorage
		// (bewust niet in de URL). Wie de pagina direct opent, ziet geen van beide blokken.
		let geboekt = "";
		let bron = "onbekend";
		try {
			geboekt = sessionStorage.getItem("jpie_eval_geboekt") || "";
			bron = sessionStorage.getItem("jpie_eval_bron") || "onbekend";
		} catch {}
		const show = (id: string) => {
			const el = document.getElementById(id);
			if (el) el.hidden = false;
		};
		if (geboekt === "Nog niet") show("boeking");
		else if (geboekt === "Ja") show("gepland");

		document.querySelectorAll<HTMLElement>("[data-track-booking]").forEach((el) => {
			el.addEventListener("click", () => {
				const w = window as any;
				w.dataLayer = w.dataLayer || [];
				w.dataLayer.push({ event: "evaluatie_boekingslink_klik", plaatsing: el.dataset.trackBooking, bron });
			});
		});
	})();
</script>
