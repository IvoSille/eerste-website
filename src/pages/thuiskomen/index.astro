---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { Picture } from "astro:assets";
import portretCrystal from "../../assets/images/Portret Crystal 1.jpg";
import SignupSwitch from "../../components/thuiskomen/SignupSwitch.astro";
import SignupCta from "../../components/thuiskomen/SignupCta.astro";
import CheckoutButtons from "../../components/thuiskomen/CheckoutButtons.astro";

// Korte sales page, alleen bedoeld om na een inzichtgesprek per WhatsApp te versturen.
// Copy: docs/korte-salespage-thuiskomen-crystal-v2.md. Bewust NOOIT indexeerbaar (robots
// noindex) en uitgesloten van de sitemap (astro.config.mjs). Niet in robots.txt zetten:
// een Disallow laat Google de noindex niet lezen en verraadt het adres.
// Bedragen en labels in de waardestapel zijn identiek aan de lange pagina
// (/thuiskomen-in-je-vrouwenlijf/). Open/dicht: zie src/lib/thuiskomen.ts.

// Blok 2: de drie koppen lopen gelijk met de drie pijlers op de lange pagina.
const krijgt = [
	{
		kop: "Je gaat begrijpen waarom je lijf dit doet.",
		items: [
			["Elke week een video", " van tien tot vijftien minuten. Die kijk je liggend, op de bank, wanneer het jou uitkomt."],
			["Een werkboek", " dat je stap voor stap naar je eigen verhaal brengt."],
			["Twee gesprekken met mij, één op één.", " Een ruim intakegesprek in de eerste week, en een persoonlijk gesprek na afloop."],
		],
	},
	{
		kop: "En het gaat landen in je lijf, want begrijpen met je hoofd verandert op zichzelf niets.",
		items: [
			["Elke week een live sessie met de groep, online.", " Hier gebeurt de diepgang. Ik werk met voice dialogue, met opstellingen en met lichaamsgerichte oefeningen, en we kijken naar wat er bij jou speelt. Kun je een keer niet, dan is er een opname."],
			["Audio-oefeningen en meditaties", " die je opzet op het moment dat je ze nodig hebt."],
			["Een dag waarop we echt samenkomen.", " In dezelfde ruimte. Daarover verderop meer."],
		],
	},
	{
		kop: "En je doet het niet meer alleen.",
		items: [
			["De Kring,", " mijn besloten groep, waar je terechtkunt als het schuurt."],
			["Een buddy", " die weet waar je aan werkt."],
			["Een sessie met de groep in januari,", " na de feestdagen."],
		],
	},
];

const extras = [
	{
		nr: 1,
		naam: "De eerste verschuiving",
		prijs: "€ 497",
		tekst: "Eén oefening die je meteen krijgt, nog voordat we beginnen. Zodat je niet tien weken hoeft te wachten op iets merkbaars.",
	},
	{
		nr: 2,
		naam: "Je symptoomdecoder",
		prijs: "€ 197",
		tekst: "Een persoonlijk document dat tien weken lang met je meegroeit. Aan het einde heb je je eigen naslagwerk, zodat je bij een nieuw symptoom niet opnieuw begint bij Google, maar bij jezelf.",
	},
	{
		nr: 3,
		naam: "De relatiekit",
		prijs: "€ 497",
		tekst: "Woorden voor de gesprekken waar je nu tegenop ziet, en een video die je kunt laten zien. Zodat het van mij komt, en jij het niet nog een keer hoeft uit te leggen.",
	},
	{
		nr: 4,
		naam: "Het veiligheidsnet",
		prijs: "€ 297",
		tekst: "Een protocol voor als het schuurt, en een audio die je meteen kunt opzetten. En als het echt even niet gaat, een directe lijn naar mij.",
	},
	{
		nr: 5,
		naam: "Het cycluskompas",
		prijs: "€ 297",
		tekst: "Een kaart van je eigen cyclus, en wat je in elke fase van jezelf mag verwachten.",
	},
	{
		nr: 6,
		naam: "Je gereedschap, voor altijd",
		prijs: "€ 397",
		tekst: "Alle video's, audio's en werkbladen blijven van jou, en je houdt toegang tot de groep. Zodat je bij een terugval niet opnieuw begint, maar teruggrijpt.",
	},
];
---

<Layout
	title="Thuiskomen in je Vrouwenlijf — alles op een rij | Crystal Helder"
	description="Wat je krijgt, wanneer het is, wat het kost en wat de garantie is. Alles op een rij, ook om door te sturen."
	robots="noindex"
	includeCal={false}
>
	<SignupSwitch />

	{/* DECORATIVE BACKGROUND BLOBS */}
	<div
		class="hidden md:block fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none"
		aria-hidden="true"
	>
		<div class="absolute top-[-10%] right-[-5%] w-[600px] h-[600px] bg-[var(--color-brand-secondary)] rounded-full mix-blend-multiply filter blur-[120px] opacity-50"></div>
		<div class="absolute top-[35%] left-[-10%] w-[520px] h-[520px] bg-[var(--color-brand-accent-light)] rounded-full mix-blend-multiply filter blur-[120px] opacity-40"></div>
	</div>

	{/* BLOK 1: BEVESTIGING */}
	<section id="hero" class="pt-14 pb-14 md:pt-24 md:pb-20 px-6 lg:px-8">
		<div class="max-w-2xl mx-auto text-center">
			<h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 text-[var(--color-brand-primary-text)] leading-tight tracking-tight">
				Thuiskomen in je Vrouwenlijf
			</h1>
			<p class="text-xl md:text-2xl font-semibold text-[var(--color-brand-muted)] leading-relaxed mb-8">
				Tien weken waarin je leert waarom je lichaam doet wat het doet. Plus een sessie in januari, zodat het daarna niet ophoudt.
			</p>
			<div class="w-24 h-24 md:w-32 md:h-32 rounded-full overflow-hidden mx-auto mb-8 border-4 border-[var(--color-brand-secondary)] shadow-lg">
				<Picture
					src={portretCrystal}
					alt="Crystal Helder"
					widths={[128, 256]}
					sizes="(max-width: 768px) 96px, 128px"
					class="w-full h-full object-cover"
					style="object-position: center 20%; transform: scale(1.5); transform-origin: 50% 47%;"
					loading="eager"
				/>
			</div>
			<div class="space-y-4 text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed mb-10">
				<p>Fijn dat we elkaar gesproken hebben.</p>
				<p>Hieronder staat alles op een rij. Wat je krijgt, wanneer het is, wat het kost, en wat er gebeurt als het bij jou toch niet blijkt te kloppen.</p>
				<p>Lees het in je eigen tempo. En wil je het thuis laten lezen, stuur deze pagina dan door. Hij is er ook voor de mensen om je heen.</p>
				<p class="signup-closed-only font-semibold text-[var(--color-brand-primary-text)]">
					De inschrijving voor deze groep is gesloten. Wil je horen wanneer er een volgende groep komt? Zet je dan op de wachtlijst.
				</p>
			</div>
			<SignupCta arrow openLabel="Naar de plek waar je je aanmeldt" data-cta-location="hero" className="text-base md:text-lg px-8 py-4 md:px-10 md:py-5" />
		</div>
	</section>

	{/* BLOK 2: WAT JE KRIJGT, EN WAARTOE */}
	<section class="py-16 md:py-24 px-6 lg:px-8 bg-white fade-in-section">
		<div class="max-w-2xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-semibold mb-10 tracking-tight">Wat je krijgt</h2>
			<div class="space-y-10">
				{krijgt.map((groep) => (
					<div>
						<h3 class="text-xl md:text-2xl font-semibold text-[var(--color-brand-primary-text)] leading-snug mb-5">{groep.kop}</h3>
						<ul class="space-y-5">
							{groep.items.map(([lead, rest]) => (
								<li class="flex items-start gap-3 text-base md:text-lg text-[var(--color-brand-muted)] leading-relaxed">
									<span class="text-[var(--color-brand-accent)] font-bold shrink-0 mt-0.5">→</span>
									<span><strong class="text-[var(--color-brand-primary-text)]">{lead}</strong>{rest}</span>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</div>
	</section>

	{/* BLOK 3: DE ZES EXTRA'S */}
	<section class="py-16 md:py-24 px-6 lg:px-8 bg-[var(--color-brand-base)] fade-in-section">
		<div class="max-w-5xl mx-auto">
			<div class="max-w-2xl mx-auto text-center mb-10 md:mb-14">
				<h2 class="text-3xl md:text-4xl font-semibold mb-4 tracking-tight">En dit heb ik erbij gemaakt</h2>
				<p class="text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed">Elk van deze zes lost iets op waarvan ik weet dat het speelt.</p>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
				{extras.map((e) => (
					<div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm shadow-[var(--color-brand-secondary)]/50">
						<h3 class="text-lg md:text-xl font-semibold mb-3">
							{e.nr}. {e.naam} <span class="font-normal text-[var(--color-brand-muted)]">· {e.prijs}</span>
						</h3>
						<p class="text-base md:text-lg text-[var(--color-brand-muted)] leading-relaxed">{e.tekst}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	{/* BLOK 4: WAAR WE HET OVER HEBBEN */}
	<section class="py-16 md:py-24 px-6 lg:px-8 bg-white fade-in-section">
		<div class="max-w-2xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-semibold mb-4 tracking-tight">Waar we het in die tien weken over hebben</h2>
			<p class="text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed mb-8">Steeds vertaald naar jouw lijf en jouw verhaal, nooit als losse theorie.</p>
			<ul class="space-y-4">
				{[
					"Hoe je lichaam werkt, en waarom het reageert zoals het reageert",
					"Wat het betekent om vrouw te zijn, en hoe je cyclus echt werkt",
					"Je eigen tijdlijn: wanneer begon dit, en wat speelde er op dat moment in je leven",
					"Waar je te veel zorg weggeeft, en waar je je niet beschermd voelt",
					"Je bekken: spanning, schaamte en grenzen in je onderlichaam",
					"Je baarmoeder en je eierstokken, en het herstel van intieme veiligheid",
					"Je cyclus in kaart, en wat je in elke fase van jezelf mag verwachten",
					"Woorden vinden voor de gesprekken met je partner, je familie en je arts",
					"Je eigen symptoomdecoder: wat zegt dit symptoom, nu",
					"Wat je doet als het terugkomt, en waarom een terugval geen achteruitgang is",
					"Wie je bent voorbij je klacht",
				].map((item) => (
					<li class="flex items-start gap-3 text-base md:text-lg text-[var(--color-brand-muted)] leading-relaxed">
						<span class="text-[var(--color-brand-sage)] font-bold shrink-0 mt-0.5">✓</span>
						{item}
					</li>
				))}
			</ul>
		</div>
	</section>

	{/* BLOK 5: DE DAG SAMEN */}
	<section class="py-16 md:py-24 px-6 lg:px-8 bg-[var(--color-brand-base)] fade-in-section">
		<div class="max-w-2xl mx-auto space-y-5 text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed">
			<h2 class="text-3xl md:text-4xl font-semibold text-[var(--color-brand-primary-text)] tracking-tight mb-8">De dag dat we samenkomen</h2>
			<p>Eén dag komen we fysiek bij elkaar, in dezelfde ruimte.</p>
			<p>Dat is geen extraatje. Het hoort bij het programma, en ik wil dat je erbij bent.</p>
			<p>We werken die dag met het lichaam, in een cirkel van vrouwen. En we maken voelbaar wat er onder je klacht speelt, op een manier die via een scherm niet lukt.</p>
			<p>Je hoeft het maar één keer mee te maken dat iemand tegenover je hetzelfde zegt als wat jij al jaren denkt, en er verandert iets.</p>
			<p>De datum en de plek prik ik zodra de groep compleet is, zodat ik rekening kan houden met wat er bij jullie past. Want ik weet dat een dag van huis voor jou geen kleinigheid is.</p>
			<p>Er is een plek om te liggen. Je mag zitten zoals je wilt, later komen en eerder gaan.</p>
		</div>
	</section>

	{/* BLOK 6: HOE DIT IN JE LEVEN PAST */}
	<section class="py-16 md:py-24 px-6 lg:px-8 bg-white fade-in-section">
		<div class="max-w-2xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-semibold mb-4 tracking-tight">Dit komt niet bovenop je leven</h2>
			<p class="text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed mb-8">Je bent moe. Dus dit is zo gebouwd dat het past in een week die al vol zit.</p>
			<ul class="space-y-4 mb-8">
				{[
					"Een video van tien tot vijftien minuten",
					"Een korte oefening of audio",
					"Eén of twee vragen in je werkboek",
					"Een live sessie van zestig tot vijfenzeventig minuten",
					"Een gesprek met je buddy, zo lang als jullie zelf willen",
				].map((item) => (
					<li class="flex items-start gap-3 text-base md:text-lg text-[var(--color-brand-muted)] leading-relaxed">
						<span class="text-[var(--color-brand-accent)] font-bold shrink-0 mt-0.5">→</span>
						{item}
					</li>
				))}
			</ul>
			<div class="space-y-5 text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed">
				<p><strong class="text-[var(--color-brand-primary-text)]">Bij elkaar zit je rond de twee uur in een week.</strong> Dat is minder dan wat je nu al kwijt bent aan de pijn en aan het leven eromheen.</p>
				<p>Het vaste moment van de sessies prik ik zodra de groep compleet is, samen met de vrouwen die erbij zijn. En kun je een keer niet, dan is er een opname.</p>
				<p>En heb je een week waarin je niets kunt, dan doe je die week niets. Alles blijft voor je klaarstaan, en je pakt het op wanneer je lijf meewerkt.</p>
			</div>
		</div>
	</section>

	{/* BLOK 7: DE DATA */}
	<section class="py-16 md:py-24 px-6 lg:px-8 bg-[var(--color-brand-base)] fade-in-section">
		<div class="max-w-2xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-semibold mb-8 tracking-tight">De data op een rij</h2>
			<dl class="space-y-3">
				{[
					["Start", "maandag 12 oktober. In die eerste week spreek ik je één op één."],
					["Duur", "tien weken. De laatste week begint maandag 14 december, dus we ronden af voor de kerst."],
					["Live sessies", "wekelijks, zestig tot vijfenzeventig minuten, online. Het vaste moment prik ik met de groep, en er is altijd een opname."],
					["De dag samen", "datum en plek prik ik zodra de groep compleet is"],
					["Nazorgsessie", "in januari, plus een persoonlijk gesprek met mij"],
					["Groepsgrootte", "acht vrouwen"],
				].map(([label, waarde]) => (
					<div class="bg-white rounded-2xl p-5 md:p-6 shadow-sm sm:grid sm:grid-cols-[10rem_1fr] sm:gap-4">
						<dt class="font-semibold text-[var(--color-brand-primary-text)] mb-1 sm:mb-0">{label}</dt>
						<dd class="text-base md:text-lg text-[var(--color-brand-muted)] leading-relaxed">{waarde}</dd>
					</div>
				))}
				<div class="signup-open-only bg-white rounded-2xl p-5 md:p-6 shadow-sm sm:grid sm:grid-cols-[10rem_1fr] sm:gap-4">
					<dt class="font-semibold text-[var(--color-brand-primary-text)] mb-1 sm:mb-0">Inschrijving sluit</dt>
					<dd class="text-base md:text-lg text-[var(--color-brand-muted)] leading-relaxed">maandag 5 oktober, 23:59</dd>
				</div>
				<div class="signup-closed-only bg-white rounded-2xl p-5 md:p-6 shadow-sm sm:grid sm:grid-cols-[10rem_1fr] sm:gap-4">
					<dt class="font-semibold text-[var(--color-brand-primary-text)] mb-1 sm:mb-0">Inschrijving</dt>
					<dd class="text-base md:text-lg text-[var(--color-brand-muted)] leading-relaxed">gesloten sinds maandag 5 oktober, 23:59</dd>
				</div>
			</dl>
		</div>
	</section>

	{/* BLOK 8: WAAR DIT NAARTOE GAAT (scenes uit de lange pagina, met de eerlijke grens ervoor) */}
	<section class="py-16 md:py-24 px-6 lg:px-8 bg-[#f4ebe6] fade-in-section">
		<div class="max-w-2xl mx-auto space-y-5 text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed">
			<h2 class="text-3xl md:text-4xl font-semibold text-[var(--color-brand-primary-text)] tracking-tight mb-8">Waar dit naartoe gaat</h2>
			<p>Ik beloof je niet dat je pijn weg is. Dat is niet aan mij, en iedereen die dat wel belooft bij een lijf als het jouwe, moet je wantrouwen.</p>
			<p class="font-semibold text-[var(--color-brand-primary-text)]">Wat er wél verandert, is dit.</p>
			<p>Op een ochtend word je wakker en merk je dat je je buik niet meteen aftast. Dat je gewoon opstaat, zonder eerst te scannen wat er vandaag gaat gebeuren.</p>
			<p>Je partner zegt op een dag, half verbaasd, dat je de laatste tijd zoveel minder gespannen bent. En je snapt eerst niet waar hij het over heeft, tot je het zelf ook merkt.</p>
			<p>Je krijgt je menstruatie en er komt geen paniek. De pijn is er misschien nog, maar de angst eromheen is weg. En dat scheelt zoveel meer dan je nu kunt geloven.</p>
			<p>Je zegt geen afspraak meer af omdat je bang bent voor wat er zou kunnen gebeuren.</p>
			<p>En op een dag hoor je jezelf iets zeggen over je lijf, en je merkt dat je niet meer praat over een vijand.</p>
		</div>
	</section>

	{/* BLOK 9: DE INVESTERING */}
	<section id="investering" class="py-16 md:py-24 px-6 lg:px-8 bg-white fade-in-section">
		<div class="max-w-2xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-semibold mb-4 tracking-tight">Wat het kost</h2>
			<p class="text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed mb-8">Even alles bij elkaar, tegen wat het los zou kosten.</p>

			<table class="w-full border-separate border-spacing-y-3 mb-8">
				<thead>
					<tr class="text-left text-sm font-semibold tracking-widest uppercase text-[var(--color-brand-muted)]">
						<th class="pb-1 px-4 font-semibold">Wat je krijgt</th>
						<th class="pb-1 px-4 text-right font-semibold">Waarde</th>
					</tr>
				</thead>
				<tbody>
					{[
						["Het lichaamsbegrip", "tien video-modules, je intake en het werkboek", "€ 997"],
						["De lichaamstaal", "voice dialogue, opstellingen, lichaamsgerichte oefeningen", "€ 2.497"],
						["De bedding", "de live sessies, de dag samen, de groep en je buddy", "€ 1.497"],
						["De zes extra's", "hierboven", "€ 2.182"],
					].map(([naam, omschrijving, waarde]) => (
						<tr class="bg-[var(--color-brand-base)] shadow-sm">
							<td class="p-4 md:p-5 rounded-l-2xl">
								<span class="font-semibold text-[var(--color-brand-primary-text)]">{naam}</span>
								<span class="text-[var(--color-brand-muted)]"> · {omschrijving}</span>
							</td>
							<td class="p-4 md:p-5 rounded-r-2xl text-right font-semibold whitespace-nowrap align-top">{waarde}</td>
						</tr>
					))}
				</tbody>
				<tfoot>
					<tr>
						<td class="pt-4 px-4 font-semibold uppercase tracking-widest text-sm text-[var(--color-brand-muted)]">Totale waarde</td>
						<td class="pt-4 px-4 text-right text-2xl md:text-3xl font-bold text-[var(--color-brand-primary-text)] whitespace-nowrap">€ 7.173</td>
					</tr>
				</tfoot>
			</table>

			<div class="space-y-5 text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed mb-10">
				<p>Als deze tien weken volgend jaar opnieuw draaien, is de prijs <strong class="text-[var(--color-brand-primary-text)]">€&nbsp;1.497</strong>.</p>
				<p class="text-2xl md:text-3xl font-bold text-[var(--color-brand-primary-text)] leading-snug">Voor deze eerste groep is het €&nbsp;997, inclusief btw.</p>
				<p>Niet omdat je minder krijgt. Je krijgt meer van mij dan iedere groep die na jou komt, omdat ik er met acht vrouwen dichterbij ben dan ik ooit nog zal zijn. Maar jij stapt in bij iets waar nog geen verhalen van anderen bij staan, en je zegt ja op mijn woord alleen. Dat is wat waard.</p>
			</div>

			<CheckoutButtons />
			<p class="signup-open-only text-sm text-[var(--color-brand-muted)] italic text-center mt-4">
				Kies je voor termijnen, dan betaal je drie maandelijkse termijnen van €&nbsp;365.
			</p>
		</div>
	</section>

	{/* BLOK 10: DE GARANTIE */}
	<section class="py-16 md:py-24 px-6 lg:px-8 bg-[var(--color-brand-base)] fade-in-section">
		<div class="max-w-2xl mx-auto">
			<h2 class="text-3xl md:text-4xl font-semibold mb-8 tracking-tight">Je draagt het risico niet alleen</h2>
			<p class="text-xl md:text-2xl font-semibold text-[var(--color-brand-primary-text)] leading-snug mb-4">Doe veertien dagen mee.</p>
			<p class="text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed mb-4">Kijk de eerste video's, kom naar de eerste sessie, doe de eerste oefening. Gewoon meedoen, niet afwachten.</p>
			<p class="text-lg md:text-xl text-[var(--color-brand-muted)] leading-relaxed mb-8">Voel je aan het einde van die veertien dagen dat dit niet is wat je zoekt, dan zeg je dat tegen me en krijg je je geld terug. Geen formulier, geen uitleg, geen ongemakkelijk gesprek.</p>

			<p class="text-xl md:text-2xl font-semibold text-[var(--color-brand-primary-text)] leading-snug mb-4">En dan de tweede.</p>
